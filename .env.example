APP_ENV=production
SECRET_KEY=PUT_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS_HERE
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres?sslmode=require
ADMIN_INITIAL_PASSWORD=PUT_A_STRONG_INITIAL_PASSWORD_HERE
SESSION_COOKIE_SECURE=1
SESSION_COOKIE_SAMESITE=Lax
SESSION_LIFETIME_MINUTES=480
MAX_CONTENT_LENGTH_MB=16
# PHARMA_DB_PATH and LOG_DIR are for non-Vercel local/server deployments only.
PHARMA_DB_PATH=/absolute/path/pharmacy_finance.db
LOG_DIR=/absolute/path/logs
HOST=127.0.0.1
PORT=8000
